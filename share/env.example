# Variables que el stack de voz lee desde ~/.config/omarchy-voice/env
# (mode 600; systemd NO hereda tu shell). Solo NOMBRES: nunca valores aquí.
#
# Obligatoria para el planner local vía Unsloth Studio (:8888) — el preset
# `local` de bytia-llm la usa como api_key_env.
UNSLOTH_LOCAL_API_KEY=
# Solo si usas el preset `cloud` de bytia-llm (Z.ai GLM).
ZAI_API_KEY=
# Solo para el preset `ollama` (puede ser un dummy: el planner aborta si
# api_key_env está vacía).
OLLAMA_LOCAL_API_KEY=
# Opcional: modo Live/OpenAI del daemon (sin tecla propia; widget/CLI).
# Sin ella, ese modo da 401 y NO afecta a F9/F10 (100% locales).
OPENAI_API_KEY=
